# Example tfvars for GitLab on Azure Container Apps (using existing network)

subscription_id              = "00000000-0000-0000-0000-000000000000"
resource_group_name          = "rg-gitlab"
location                     = "eastus"
# Leave blank to auto-generate; optionally override
unique_suffix                = ""

# Existing network objects (supply full subnet resource IDs)
container_apps_subnet_id     = "/subscriptions/<sub>/resourceGroups/rg-network/providers/Microsoft.Network/virtualNetworks/vnet-hub/subnets/snet-containerapps"
private_endpoints_subnet_id  = "/subscriptions/<sub>/resourceGroups/rg-network/providers/Microsoft.Network/virtualNetworks/vnet-hub/subnets/snet-private-endpoints"
postgresql_subnet_id         = "/subscriptions/<sub>/resourceGroups/rg-network/providers/Microsoft.Network/virtualNetworks/vnet-hub/subnets/snet-postgresql"

# GitLab configuration
gitlab_hostname              = "gitlab.contoso.com"
# For production use Key Vault; here placeholders
gitlab_root_password         = "CHANGE-ME"
gitlab_runner_token          = "RUNNER-TOKEN"

# PostgreSQL configuration
postgresql_admin_password                = "CHANGE-ME-DB-PASSWORD"  # PostgreSQL admin password (remember to change in production)
postgresql_version                       = "16"                      # PostgreSQL version (16 or 17)
postgresql_administrator_login           = "psqladmin"               # PostgreSQL admin username
postgresql_sku_name                      = "B_Standard_B2ms"        # 2 vCPU, 8 GB RAM (B_Standard_B2ms for dev, GP_Standard_D4s_v3 for prod)
postgresql_storage_mb                    = 32768                    # 32 GB storage (minimum for production)
postgresql_storage_tier                  = "P10"                    # P10 = 500 IOPS (P4/P6 for dev, P10+ for prod)
postgresql_backup_retention_days         = 7                        # Backup retention in days
postgresql_geo_redundant_backup_enabled  = false                    # Enable geo-redundant backups (true for prod)
postgresql_high_availability_mode        = "Disabled"               # HA mode: Disabled, SameZone, ZoneRedundant
postgresql_zone                          = "1"                      # Availability zone
postgresql_location                      = "eastus"                # Optional override region for PostgreSQL Flexible Server (set if primary region restricted)

# Optional shared tags
# tags = { environment = "dev" owner = "team-devops" }

# Storage replication choice (SKU tiers hard-coded where required)
storage_account_replication_type = "LRS"

# Container Apps Environment workload profile (Consumption, D4, D8, D16, D32, E4, E8, E16, E32)
# D4 = 4 vCPU, 16GB RAM | D8 = 8 vCPU, 32GB RAM | E4 = 4 vCPU, 32GB RAM (memory-optimized)
workload_profile_type = "D4"

# Azure Files shares for GitLab (name, quota in GiB, container mount path)
file_shares = [
  { name = "gitlab-config", quota = 100, path = "/etc/gitlab" },
  { name = "gitlab-data",   quota = 500, path = "/var/opt/gitlab" },
  { name = "gitlab-logs",   quota = 100, path = "/var/log/gitlab" }
]
